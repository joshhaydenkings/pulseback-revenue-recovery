DEMO_MODE=true
# Canonical origin. Use the final public HTTPS origin in hosted environments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hosted runtime: use a pooled/serverless URL here.
DATABASE_URL=
# Migrations and intentional seeding: use the provider's direct URL here.
DIRECT_URL=
# Generic Node host: pg + node. Sites/Workers with Neon: neon + workerd.
DATABASE_DRIVER=pg
DATABASE_RUNTIME=node

NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional server-only hosted intelligence. Groq is the default provider.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional alternative hosted provider. Set AI_PROVIDER=openai to use it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Required by /api/cron/recovery. Send it as a Bearer token.
CRON_SECRET=
